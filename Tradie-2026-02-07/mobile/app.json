{
  "expo": {
    "name": "Tradie",
    "slug": "tradie",
    "scheme": "tradie",
    "version": "1.6.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/Tradie_App_Store_1024x1024_1.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibecode.tradie.5sttp4",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Tradie uses your camera to take photos of job sites and completed work for quotes and invoices.",
        "NSCalendarsUsageDescription": "Tradie syncs your scheduled jobs to your calendar so you never miss an appointment.",
        "NSPhotoLibraryUsageDescription": "Tradie accesses your photo library to attach photos of job sites and completed work.",
        "NSMicrophoneUsageDescription": "Tradie uses your microphone for audio recording when documenting job sites."
      }
    },
    "android": {},
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-mail-composer",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44490c71-b755-47b8-bbe1-1936189cc28b"
      }
    },
    "owner": "builtbyomnia"
  }
}
