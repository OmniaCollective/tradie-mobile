# Set these in Vercel → Project → Settings → Environment Variables (Production).
# Never commit real values.

# Sign in with Apple
APPLE_TEAM_ID=ZLFMZ6YLM5
APPLE_KEY_ID=729RU9DGAZ
APPLE_BUNDLE_ID=com.vibecode.tradie.5sttp4
# Full contents of the "Tradie Sign in with Apple" .p8 file, including the BEGIN/END lines
APPLE_PRIVATE_KEY=

# Signs the app's session tokens. Any long random string (e.g. `openssl rand -base64 48`).
SESSION_SECRET=

# Groq (voice). The "tradie-ios" key — once the app uses this server, the key no longer ships in the app.
GROQ_API_KEY=

# RevenueCat secret API key (v1, starts with sk_). RevenueCat → Project settings → API keys.
REVENUECAT_SECRET_KEY=

# Apple Maps Server API (drive times for "Suggest times"). A key with the Maps capability
# from the Apple developer account; APPLE_TEAM_ID above is reused.
APPLE_MAPS_KEY_ID=
# Full contents of that key's .p8 file
APPLE_MAPS_PRIVATE_KEY=
